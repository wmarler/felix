[Unit]
Description=adguard and adguard-sync docker compose linked services
PartOf=docker.service
Requires=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=simple
Slice=docker-compose.slice
WorkingDirectory=/etc/docker-compose/adguard2

# Tear down any existing state before starting
ExecStartPre=-/usr/bin/docker compose -f compose.yaml down

# Run in the foreground so systemd tracks the process
ExecStart=/usr/bin/docker compose -f compose.yaml up

# Graceful shutdown
ExecStop=/usr/bin/docker compose -f compose.yaml down

# Let systemd handle the restart logic
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
